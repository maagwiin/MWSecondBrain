[Unit]
Description=MWSecondBrain private dashboard
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=mwsb
Group=mwsb
WorkingDirectory=/opt/mwsecondbrain/current
EnvironmentFile=/etc/mwsecondbrain/environment
ExecStart=/opt/mwsecondbrain/current/.venv/bin/uvicorn mwsecondbrain.app:create_from_env --factory --host 127.0.0.1 --port 8765 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
